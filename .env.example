# Environment variables (copy to .env and fill in values)
# NEVER commit the .env file to git

# ─── Ingestion source ────────────────────────────────────
# arctic_shift (default, no credentials) | praw (needs Reddit API keys below)
FETCHER_PROVIDER=arctic_shift

# ─── Reddit API (https://www.reddit.com/prefs/apps) ──────
# Only required when FETCHER_PROVIDER=praw
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RetailSentimentIntelligence/1.0

# ─── Azure Cosmos DB ─────────────────────────────────────
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-primary-key-here
COSMOS_DATABASE=retail_sentiment

# ─── LLM Configuration ──────────────────────────────────
# Provider: "huggingface" (free, default) | "openai" | "azure_openai" | "llm_gateway" | "local"
LLM_PROVIDER=huggingface
LLM_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Walmart LLM Gateway (when LLM_PROVIDER=llm_gateway)
# Used for trust credibility scoring; sentiment stays on local HF model (free)
WMT_LLM_GATEWAY_URL=https://llmgateway-stg.walmart.com/v1
WMT_LLM_GATEWAY_KEY=
WMT_LLM_GATEWAY_MODEL=gpt-4o-mini

# Azure OpenAI (when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# HuggingFace (when LLM_PROVIDER=huggingface)
HF_TOKEN=

# ─── Pipeline Settings ───────────────────────────────────
INGESTION_INTERVAL_MINUTES=60
BACKFILL_DAYS=90
TRUST_THRESHOLD=0.5
CONFIDENCE_THRESHOLD=0.7
BATCH_SIZE=50
MAX_COMMENTS_PER_POST=10
COMMENT_MIN_SCORE=3
COMMENT_MAX_DEPTH=2

# ─── Dashboard ───────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
